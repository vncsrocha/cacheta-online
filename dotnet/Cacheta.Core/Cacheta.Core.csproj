<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compila o mesmo código do pacote Unity fora do Unity, para testes e para o futuro servidor. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- C# 9 = o que o Unity 2021.3+ suporta. Não suba sem checar o Unity. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity-package/com.vncsrocha.cacheta.core/Runtime/**/*.cs" />
  </ItemGroup>
</Project>
